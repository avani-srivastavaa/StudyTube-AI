# ─── Backend API ──────────────────────────────────────────────────────────────
# Where your FastAPI backend is running.
VITE_API_BASE_URL=http://localhost:8000/api

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
# Safe to expose in the browser — these are the PUBLIC anon keys.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# If both Supabase vars are left blank, the app runs in guest-only mode —
# no login, no persistence, but full video analysis still works.
